{
  "name": "smartstock",
  "version": "0.1.0",
  "description": "SmartStock (SAP) — Enterprise-Grade Desktop Barcode & QR Stock Monitoring System (Electron + SQLite)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node tests/run.js",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "build": "electron-builder build --win",
    "build:dir": "electron-builder build --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fadhlijeu/smartstock.git"
  },
  "author": "Fadhlijeu",
  "license": "ISC",
  "keywords": [
    "electron",
    "stock",
    "barcode",
    "qr",
    "inventory"
  ],
  "bugs": {
    "url": "https://github.com/Fadhlijeu/smartstock/issues"
  },
  "homepage": "https://github.com/Fadhlijeu/smartstock#readme",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@material-symbols/font-300": "^0.45.10",
    "better-sqlite3": "^9.4.3",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.smartstock.app",
    "productName": "SmartStock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**/*",
      "!src/renderer/assets/fonts/**"
    ]
  }
}
